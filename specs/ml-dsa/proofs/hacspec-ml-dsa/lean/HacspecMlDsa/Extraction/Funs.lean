        let hash_input1 := index_mut_back s4
        let i2 ← 64#usize + W1_BYTES
        let (s5, index_mut_back1) ←
          core.Array.Insts.CoreOpsIndexIndexMut.index_mut
            (core.Slice.Insts.CoreOpsIndexIndexMut
            (core.ops.range.RangeUsize.Insts.CoreSliceIndexSliceIndexSliceSlice
            Std.U8)) hash_input1 { start := 64#usize, «end» := i2 }
        let s6 ← lift (Array.to_slice w1_encoded)
        let s7 ←
          core.slice.Slice.copy_from_slice core.U8.Insts.CoreMarkerCopy s5 s6
        let hash_input2 := index_mut_back1 s7
        let s8 ←
          core.Array.Insts.CoreOpsIndexIndex.index
            (core.Slice.Insts.CoreOpsIndexIndex
            (core.ops.range.RangeToUsize.Insts.CoreSliceIndexSliceIndexSliceSlice
            Std.U8)) hash_input2 { «end» := i2 }
        let c_tilde_prime_full ← hash_functions.h 64#usize s8
